 "ch1.diagnosis": {
  "lines": [
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "ハル。ここは心臓部の前室です。オルドの状態を診断しました。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "オルドの動力が、枯渇しています。直前の二つのノードで、補給できなかった形跡があります。"
   },
   {
    "who": "ハル",
    "face": "normal",
    "text": "ノード？"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "巡礼機にエネルギーを補給する、先史の施設です。補給できなければ、巡礼機は止まります。"
   },
   {
    "who": "ハル",
    "face": "serious",
    "text": "それで、オルドは止まったのか。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "はい。この奥の炉心に、フレームの予備動力を流せば、再始動できると推定します。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "ただし、炉心の扉を閉ざす大型の番機が、すでに起動しています。"
   },
   {
    "who": "ハル",
    "face": "smirk",
    "text": "邪魔するなら、ぶっ飛ばすだけだ。……ビーコンで休んで、準備してから行く。"
   }
  ]
 },
 "ch1.r19.enter": {
  "lines": [
   {
    "who": "ハル",
