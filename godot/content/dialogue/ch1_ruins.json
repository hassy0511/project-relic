 "ch1.fit.c": {
  "lines": [
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "起動シーケンス完了。……登録者の生体情報と一致しません。血縁と推定。仮登録します。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "はじめまして、ハル。"
   },
   {
    "who": "ハル",
    "face": "surprised",
    "text": "しゃ、しゃべった！？ 光る球が！ ……っていうか、なんで俺の名前を。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "私はナゴミ。外装フレーム〈ヴェスティージ〉の補助 AI です。名前は、あなたの生体情報から取得しました。"
   },
   {
    "who": "ハル",
    "face": "serious",
    "text": "ヴェスティージ……。親父の……？ 血縁って、どういうことだ。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "登録者の記録は参照できません。私は起動したばかりで、この世界のことを何も知りません。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "質問します。ここは、どこですか？ 巡礼機……とは、何ですか？"
   },
   {
    "who": "ハル",
    "face": "surprised",
    "text": "ええと……オルドっていう、でっかい機械の亀で——って、そこからかよ！"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "理解しました。……理解できていません。説明をお願いします。あとで。"
   },
   {
    "who": "ハル",
    "face": "smirk",
    "text": "あとでな。……まあいい。よろしく、ナゴミ。"
   }
  ]
 },
 "ch1.fit.t1": {
  "lines": [
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "ハル。フレームの機能を確認します。訓練用の標的を投影しました。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "ロックオンで照準を固定します。左トリガー、または右クリックを押し続けてください。照準が敵を追います。"
   }
  ]
 },
 "ch1.fit.t2": {
  "lines": [
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "命中を確認。次は 2 体です。ロックオンしたまま、狙う相手を切り替えられます。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "……ハル、標的は飛びかかってきます。実戦に近い設定です。"
   },
   {
    "who": "ハル",
    "face": "surprised",
    "text": "近すぎだろ、それ！"
   }
  ]
 },
 "ch1.fit.t3": {
  "lines": [
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "訓練を完了しました。ハルの動作は、想定の 60% を上回りました。"
   },
   {
    "who": "ハル",
    "face": "smirk",
    "text": "60% って、褒めてんのか？"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "はい。……冗談、というものを学習中です。今のは、面白かったですか？"
   },
   {
    "who": "ハル",
    "face": "laugh",
    "text": "……惜しい。もう一息。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "補足します。フレームは長く眠っていたため、動いているのは胴の核だけです。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "腕と脚の回路は、動力が戻れば順に目覚めるはずです。"
   },
   {
    "who": "ハル",
    "face": "smirk",
    "text": "まだ伸びしろがあるってことか。"
   }
  ]
 },
