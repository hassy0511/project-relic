 "ch1.node": {
  "lines": [
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "……接続中。この炉心の、ノードの記録を取り込みます。"
   },
   {
    "who": "",
    "face": "normal",
    "text": "ナゴミの光が、淡く脈打つ。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "取り込みました。オルドの記憶を取り込みました。"
   },
   {
    "who": "ハル",
    "face": "surprised",
    "text": "取り込んだ？ 何をだ？"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "この場所で起きたことの記録です。オルドは、およそ 1 年前から、ある場所を目指して歩いています。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "目的地を確認。……ターミナス。1 年前から、すべての巡礼機が、同じ場所を目指しています。"
   },
   {
    "who": "ハル",
    "face": "serious",
    "text": "ターミナス……。親父が、最後に『行く』って言ってた場所だ。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "ハルの父親が？"
   },
   {
    "who": "ハル",
    "face": "normal",
    "text": "……いや、今は後だ。町が待ってる。"
   },
   {
    "who": "ナゴミ",
    "face": "normal",
    "text": "補給しなければ、オルドはまた止まります。次のノードまでは、持ちます。"
   },
   {
    "who": "ハル",
    "face": "smirk",
    "text": "次のノード、か。……動かして終わりじゃないんだな。"
   }
  ]
 },
 "ch1.cheer": {
