   }
  ]
 },
 "ch1.gen.night": {
  "lines": [
   {
    "who": "老人ゲン",
    "face": "normal",
    "text": "七十年生きてきて、オルドが止まったのは初めてじゃ。……こりゃあ、ただごとじゃないぞ。"
   }
  ]
 },
 "ch1.domi.day": {
  "lines": [
   {
    "who": "食堂のドミ",
    "face": "normal",
    "text": "いらっしゃい、って言いたいが、店は仕込み中だ。ヤーナの揚げパンなら、工房の前で売ってるぞ。"
   }
  ]
 },
 "ch1.domi.night": {
  "lines": [
   {
    "who": "食堂のドミ",
    "face": "normal",
    "text": "火が使えるうちに、今夜の分は作っておくさ。腹が減っちゃ、戦もできねえからな。"
   }
  ]
 },
 "ch1.tobi.day": {
  "lines": [
   {
    "who": "少年トビ",
    "face": "normal",
    "text": "ハル兄ちゃんの、ツケ、また増えたって聞いたよ！"
   }
  ]
 },
 "ch1.tobi.night": {
  "lines": [
   {
    "who": "少年トビ",
    "face": "normal",
    "text": "こわいよ……。ハル兄ちゃん、父ちゃんが遺構に行くとか言ってるんだ。止めてよ。"
   }
  ]
 },
 "ch1.lookout.day": {
  "lines": [
   {
    "who": "見張りのロブ",
    "face": "normal",
    "text": "ここからなら、砂漠の地平線までよく見える。今日は、いい天気だ。"
   }
  ]
 },
 "ch1.lookout.night": {
  "lines": [
   {
    "who": "見張りのロブ",
    "face": "normal",
    "text": "星だけは、変わらず綺麗に見えるな。……オルドが止まっても、空は動いているんだな。"
   }
  ]
 },
 "ch1.clerk.day": {
  "lines": [
   {
    "who": "ギルドの事務員",
